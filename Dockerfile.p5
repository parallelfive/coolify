# Parallel Five custom Coolify image
# Extends the official image with patches until they're merged upstream.
# Rebuild when upstream releases a new version or when adding new patches.
# The base MUST match the upstream version the patched files were rebased onto.
# A moving :latest tag silently re-bases the patches onto whatever shipped last.
FROM ghcr.io/coollabsio/coolify:4.7.5

# Fix: Flysystem put() fails on 0600 SSH key overwrite (PR #9491)
COPY app/Models/PrivateKey.php /var/www/html/app/Models/PrivateKey.php

# Fix: Sentinel bind mount chmod fails on macOS (uses Docker volume instead)
COPY app/Actions/Server/StartSentinel.php /var/www/html/app/Actions/Server/StartSentinel.php

# Fix: Websocket proxy for terminal + realtime through Cloudflare Tunnel
COPY patches/default.conf /etc/nginx/conf.d/default.conf
COPY patches/terminal-proxy.conf /etc/nginx/site-opts.d/terminal.conf

# Fix: POSIX size check in DatabaseBackupJob (GNU `du -b` isn't on macOS/BSD)
COPY app/Jobs/DatabaseBackupJob.php /var/www/html/app/Jobs/DatabaseBackupJob.php

# Fix: skip apt/dnf/pacman patch check on macOS hosts — our localhost server
# runs on a MacBook, which has no /etc/os-release, so the unpatched
# CheckUpdates action fires a "Server patch check failed" notification every
# cycle. The patched version short-circuits on Darwin.
COPY app/Actions/Server/CheckUpdates.php /var/www/html/app/Actions/Server/CheckUpdates.php

# Fix: no ACME resolver — Cloudflare Tunnel terminates TLS and speaks plain HTTP to
# Traefik, so a letsencrypt certresolver on the dashboard routers always fails with
# "Router uses a nonexistent certificate resolver letsencrypt".
# Both files were patched in p5/patched but never COPY'd, so the patch had never
# actually reached the image.
COPY bootstrap/helpers/proxy.php /var/www/html/bootstrap/helpers/proxy.php
COPY app/Models/Server.php /var/www/html/app/Models/Server.php

# NOT applied from 4.7.5: patches/default.conf and patches/terminal-proxy.conf.
# Upstream proxies /terminal/ws in site-opts.d/http.conf and runs realtime in-process,
# and the stock image ships no conf.d/default.conf. Overlaying our server block made
# nginx die at startup with "host not found in upstream coolify-realtime" (it resolved
# that name at start), so the container never became healthy. Keep them in the repo for
# history, but do not copy them back without checking upstream's nginx layout first.
